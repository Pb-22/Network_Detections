alert http any any -> any any (msg:"PB22 MALWARE RedFlick DNSObserver HTTP C2 Check-in"; flow:established,to_server; http.method; content:"GET"; startswith; endswith; http.uri; content:"/dns/request?ui="; startswith; pcre:"/^\/dns\/request\?ui=[A-Za-z0-9+\x2f=]{24,256}(?:&|$)/"; http.user_agent; content:"DNSObserver"; startswith; endswith; fast_pattern; reference:url,dslua.org/publications/spearphishing-via-fake-urc-2026-invitations-targets-ukrainian-csos/; reference:url,microsoft.com/en-us/security/blog/2026/09/29/star-blizzard-refines-phishing-and-malware-delivery-with-the-redflick-technique; classtype:trojan-activity; sid:1000201; rev:1; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, affected_product Windows_11, attack_target Client_Endpoint, created_at 2026_11_11, deployment Perimeter, performance_impact Moderate, confidence Medium, signature_severity Major, tag RedFlick, tag Star_Blizzard, tls_state plaintext, updated_at 2026_11_11; target:src_ip;)
